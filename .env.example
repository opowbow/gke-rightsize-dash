# Google Cloud Project ID where your GKE clusters and Cloud Monitoring metrics reside
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Google Cloud Region / Location for Vertex AI (e.g. us-central1, europe-west1)
GOOGLE_CLOUD_LOCATION=us-central1

# Enable Vertex AI backend for google-genai (1 for Vertex AI, 0 for Gemini Developer API)
GOOGLE_GENAI_USE_VERTEXAI=1

# Gemini Model Name (recommended: gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash
